[Unit]
Description=derisk agent control service
Documentation=https://github.com/dasmatus/derisk
Requires=derisk-agent.socket
After=derisk-agent.socket
PartOf=derisk-session.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=derisk agent --socket-activated --execute
WatchdogSec=30s
Restart=on-failure
RestartSec=1s
Slice=session.slice
# The agent only needs its socket and the user manager.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
