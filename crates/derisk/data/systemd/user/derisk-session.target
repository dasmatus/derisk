[Unit]
Description=derisk desktop session
Documentation=https://github.com/dasmatus/derisk
# Started by the compositor once WAYLAND_DISPLAY is exported
# (see derisk::systemd::session_start_argv). Pulls in the generic graphical
# session so portals, tray hosts and XDG autostart units follow it.
BindsTo=graphical-session.target
# Not derisk-agent.socket: `derisk session` serves the agent socket itself,
# on the live desktop, and a headless agent on the same path would refuse it.
Wants=graphical-session-pre.target xdg-desktop-autostart.target
After=graphical-session-pre.target
Before=xdg-desktop-autostart.target
RefuseManualStart=no
StopWhenUnneeded=yes
