[Unit]
Description=derisk agent control socket
Documentation=https://github.com/dasmatus/derisk
# The headless agent, for running derisk without a desktop. A desktop
# session serves the same socket from the compositor, so it stops this one.
Conflicts=derisk-session.target

[Socket]
# JSON-lines agent protocol; only the session user may connect.
ListenStream=%t/derisk/agent.sock
SocketMode=0600
DirectoryMode=0700
RemoveOnStop=yes
